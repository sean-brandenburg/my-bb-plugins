{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "server.ts",
    "server",
    "host.ts",
    "host",
    "contract.ts",
    "rpc-contract.ts",
    "app.tsx",
    "shared",
    "ui",
    "components",
    "lib",
    "hooks"
  ],
  "exclude": [
    "**/*.test.ts",
    "node_modules"
  ]
}
